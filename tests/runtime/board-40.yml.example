  phpbb_branch: 'master'
  server_name: localhost
  server_port: '8121'
  nginx_site: /etc/nginx/sites-available/phpbb-adminactivationdetails-40-test.conf
  seeds: []
styles: {}
extensions:
  adminactivationdetails:
    source: /path/to/adminactivationdetails
